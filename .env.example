# Server
PORT=3001
NODE_ENV=development

# Public URL of the deployed app (used for CORS in production)
FRONTEND_URL=http://localhost:5173

# MongoDB (required for API data endpoints; use an Atlas URI in production)
MONGODB_URI=mongodb://localhost:27017/emergency_triage

# Routing (OpenRouteService - free)
ORS_API_KEY=your_openrouteservice_api_key

# AI Chat (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key
